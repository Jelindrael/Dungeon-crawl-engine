{
  "name": "morgenrot",
  "version": "1.0.0",
  "private": true,
  "description": "Morgenrot – ein Länder-Management-Spiel über den Aufbau einer gerechteren Welt (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "balance": "vitest run tests/balance.test.ts --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "preact": "^10.27.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
